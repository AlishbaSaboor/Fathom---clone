# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Gemini API key (https://aistudio.google.com/apikey). Transcription, summaries and Ask Fathom.
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Atlas connection string (a database user with readWrite on ONE database, not an admin user).
# Include the database name, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fathom
# URL-encode any special characters in the password.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/fathom

# Vercel Blob store (create a PUBLIC store and connect it to the project, then `vercel env pull .env.local`).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
BLOB_STORE_ID=store_xxxxxxxx

# Optional
# MONGODB_DB=fathom            # only if the connection string does not name a database
# GEMINI_MODEL=gemini-3.5-flash  # one model id, or a comma-separated fallback list
